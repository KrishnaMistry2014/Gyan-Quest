# Google Gemini API Secret Key (Server & Browser Runtime Keys)
GEMINI_API_KEY=
VITE_GEMINI_API_KEY=
VITE_GURU_GEMINI_API_KEY=

# Firebase Configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=

# Cloudflare Workers AI Configuration
# Option A: Deployed Cloudflare Worker URL for Firebase-hosted SPA (e.g. https://gyanquest-image-proxy.<subdomain>.workers.dev)
VITE_CLOUDFLARE_WORKER_URL=

# Option B: Server-Side Only environment variables for local dev / server.ts proxy
# Generate a token at https://dash.cloudflare.com/profile/api-tokens with Workers AI Read/Edit permissions
CLOUDFLARE_API_TOKEN=
# Optional: Specify your Cloudflare Account ID (if omitted, the server will auto-discover it via API)
CLOUDFLARE_ACCOUNT_ID=